{
  "schemaVersion": 3,
  "protocol": "halo-score",
  "engine": "NotBad Halo Music Constructor",
  "references": {
    "agentGuide": "AGENT_GUIDE.md#contents",
    "capabilities": "capabilities.json",
    "instruments": "instruments.json",
    "musicRules": "music-rules.json",
    "projectState": "project-state.json"
  },
  "authority": "File Bridge SCORE (партитура) contract only. WebMCP is a separate API.",
  "delivery": {
    "agentWrite": [
      "requests/"
    ],
    "haloOnlyWrite": [
      "responses/",
      "AGENT_GUIDE.md",
      "capabilities.json",
      "instruments.json",
      "music-rules.json",
      "project-state.json"
    ],
    "request": "requests/<ID>.json",
    "receipt": "responses/<ID>.result.json",
    "companion": "requests/<ID>--<role>.json",
    "reference": "<ID>--<role>.json",
    "directories": "HALO creates requests/ and responses/. Agents never create directories.",
    "publication": "Complete and read back companions first, publish and read back REQUEST (запрос) last.",
    "root": "Verify one connected BRIDGE_ROOT (корневая папка) containing AGENT_GUIDE.md, project-state.json, requests/ and responses/. Bind immutable path variables BRIDGE_ROOT (корневая папка), STATE_PATH, REQUEST_PATH and RECEIPT_PATH once per task. Binding a path never authorizes writing that file; STATE_PATH and RECEIPT_PATH are read-only to the agent."
  },
  "timing": {
    "BAR": "Ordinary musical BAR (такт), not a special HALO unit: 4 quarter-note BEAT (доля) in 4/4; 3 in 3/4.",
    "BEAT": "One quarter note in both supported meters. A BEAT (доля) is not a BAR (такт) or a STEP (шаг сетки).",
    "TEMPO": "Quarter-note BEAT (доля) per minute, not BAR (такт) per minute.",
    "STEP": "One sixteenth note (semiquaver): 4 STEP (шаг сетки) per BEAT (доля); 16 per 4/4 BAR (такт), 12 per 3/4 BAR (такт).",
    "POSITION": "Zero-based event onset within ONE PHRASE (фраза); never resets at a BAR (такт) boundary. Each different PHRASE (фраза) starts again at 0.",
    "PHRASE": "HALO SCORE (партитура) container of 4 or 8 musical BAR (такт); not a fixed duration in seconds.",
    "SECTION": "COMPOSITION (композиция) arrangement entry referencing a PHRASE (фраза) and its repeats; not a second event-position grid.",
    "REST": "Intentional absence of new attacks; earlier sounds may sustain. Empty BAR (такт) are allowed; events are never filled or repeated automatically."
  },
  "limits": {
    "tempo": [
      30,
      200
    ],
    "bars": [
      4,
      8
    ],
    "tracks": 8,
    "stepsPerBar": {
      "4/4": 16,
      "3/4": 12
    },
    "phrases": 15,
    "sections": 32,
    "totalBars": 128,
    "bytes": 524288
  },
  "syntax": {
    "canonical": "JSON matching requestSchema",
    "acceptedPresentation": [
      "UTF-8 BOM",
      "one json/jsonc/json5 code fence",
      "line and block comments",
      "trailing commas",
      "single-quoted strings",
      "unquoted identifier keys and single-token string values",
      "missing commas between whitespace-separated complete values"
    ],
    "neverRepair": "Never invent missing values, colons, closing quotes/brackets, split fused numbers, resolve duplicate keys, execute expressions or change musical data. All semantic/revision/path checks still apply after parsing."
  },
